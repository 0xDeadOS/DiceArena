# Copy to .env. Never use a VITE_ prefix for secrets.
DATABASE_URL=postgresql://dicebound:dicebound@localhost:5432/dicebound?schema=public
# Obtain this locally from BotFather; never put a real token into Git.
BOT_TOKEN=123456789:replace_with_your_bot_token
# Mini App short name configured via BotFather /newapp (not the bot username).
APP_SHORT_NAME=dicebound
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# Signed Telegram initData expires after 24 hours. Future tolerance is 30 seconds.
INIT_DATA_MAX_AGE_SECONDS=86400
# Server-side Vite proxy; browser code always uses relative /api URLs.
API_PROXY_TARGET=http://127.0.0.1:3001

# --- Deployment (Render and similar platforms) -----------------------------
# Run the Telegram bot inside the API process. Required on platforms without
# free background workers: a polling bot makes no inbound request, so a
# separate service is idle and gets spun down. Set to false to run HTTP only.
RUN_BOT=false
# Comma-separated frontend origins allowed to call the API from a browser.
# Needed when the UI is served from a different origin (Render Static Site).
# CORS_ORIGINS=https://dicebound-web.onrender.com
# Trust X-Forwarded-* from the platform proxy, so IP rate limiting sees real
# client addresses instead of the proxy address.
TRUST_PROXY=false
# Build-time only: API origin baked into the web bundle when the UI is hosted
# on another origin. Not a secret. Leave empty for same-origin deployments.
# VITE_API_ORIGIN=https://dicebound-api.onrender.com
# Integration tests require a SEPARATE empty PostgreSQL database.
# TEST_DATABASE_URL=postgresql://dicebound:dicebound@localhost:5432/dicebound_test?schema=public
