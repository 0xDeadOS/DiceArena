# ─── Path of Dice ────────────────────────────────────────────────────────────
# Токен бота из @BotFather. Без него Web App работает в локальном/гостевом режиме.
BOT_TOKEN=

# Числовой Telegram ID администратора (получает закреплённый бэкап БД в личке).
ADMIN_ID=

# Секрет для HMAC-подписи токенов и персональных ссылок. ОБЯЗАТЕЛЬНО поменяй!
SESSION_SECRET=change-me-path-of-dice-secret

# Публичный HTTPS-адрес приложения (Render / Railway / cloudflared).
# Используется в кнопке web_app Telegram-бота.
WEBAPP_URL=http://localhost:3000

PORT=3000
NODE_ENV=development

# Автоматически поднимать бесплатный HTTPS-туннель при локальной разработке
# (пробует cloudflared, затем localhost.run через ssh). Значение по умолчанию: 0.
TUNNEL=0

# Пинг собственного /health каждые 14 минут, чтобы Render не усыплял контейнер.
# Например: https://path-of-dice.onrender.com
KEEP_ALIVE_URL=

# Разрешить выбор профиля по X-Player-Id (удобно для локальных тестов и демо).
ALLOW_DEV_AUTH=true

# Путь к JSON-базе (по умолчанию data/db.json).
DB_PATH=
